+/**
+ * A brace-leading argument that failed both inline parsing and its file read
+ * is treated as inline JSON only when it could actually start a JSON document
+ * (`{` followed by a quoted key, or an array). `{data}` and friends cannot
+ * begin valid JSON at all — those are mistyped file paths, so the file read
+ * error (which names the path and the system code) is the truthful diagnostic
+ * instead of a misleading "expected JSON".
+ */
+const plausibleInlineJson = (value: string): boolean => {
+  const trimmed = value.trimStart();
+  if (trimmed.startsWith("[")) return true;
+  return /^\{\s*"/.test(trimmed);
+};
